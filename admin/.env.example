# Copy to admin/.env locally; never commit live configuration or private data.
# The launcher reads environment variables, not this file automatically.
T2N_ORIGIN=http://localhost:4180
T2N_GOOGLE_CLIENT_ID=
# Set the stable Google subject after verifying Raviv's identity.
# If unset, first login can bind ONLY the verified Workspace owner below.
T2N_OWNER_SUB=
T2N_DATABASE=data/private/admin.sqlite3
